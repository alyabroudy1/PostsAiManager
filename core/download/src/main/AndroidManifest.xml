<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared by the module that actually opens sockets, rather than left for the app to
      remember. A library whose entire purpose is downloading should carry its own
      requirement, so adding it to a new app cannot silently produce a downloader that
      cannot reach the network.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
