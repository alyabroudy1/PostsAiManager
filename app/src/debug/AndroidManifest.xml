<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- DEBUG ONLY: imports images the test harness pushed to the app's external files "debug-import" folder as one document. -->
        <activity
            android:name="com.postsaimanager.debug.DebugImportActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- DEBUG ONLY: serves the same folder as content:// URIs, so the share and "Open with" intents can be tried without another app. -->
        <provider
            android:name="com.postsaimanager.debug.DebugShareProvider"
            android:authorities="${applicationId}.testshare"
            android:exported="false" />

        <!-- DEBUG ONLY: starts a SEND_MULTIPLE share of named files from that folder (am cannot build a URI list itself). -->
        <activity
            android:name="com.postsaimanager.debug.DebugShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
